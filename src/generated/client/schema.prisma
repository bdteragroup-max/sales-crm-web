model PurchaseOrder {
  id       String  @id @default(cuid())
  poNumber String?
  jobId    String
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  supplierName  String?
  supplierPhone String?

  items        Json?
  totalAmount  Float?
  expectedDate DateTime? @db.Timestamptz(6)

  status String @default("รอสินค้า")

  createdBy String?
  note      String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("purchase_orders")
}

model Project {
  id            String  @id @default(cuid())
  projectNumber String  @unique // e.g., PJ69-0001
  jobId         String? @unique
  job           Job?    @relation(fields: [jobId], references: [id])

  name        String
  description String?
  clientName  String?
  siteAddress String?

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  startDate           DateTime? @db.Timestamptz(6)
  endDate             DateTime? @db.Timestamptz(6)
  budget              Float?
  externalTechnicians String?

  status String @default("Planning")
  // Planning | In progress | Paused | Completed | Cancelled

  // --- New Project Outline Fields ---
  projectCategory String?
  department      String?
  province        String?
  district        String?

  projectValue       Decimal? @db.Decimal(15, 2)
  securityDeposit    Decimal? @db.Decimal(15, 2)
  penaltyPerDay      Decimal? @db.Decimal(15, 2)
  amountIncludingVat Decimal? @db.Decimal(15, 2)

  installment1  Decimal? @db.Decimal(15, 2)
  installment2  Decimal? @db.Decimal(15, 2)
  installment3  Decimal? @db.Decimal(15, 2)
  installment4  Decimal? @db.Decimal(15, 2)
  firstPayment  Decimal? @db.Decimal(15, 2)
  secondPayment Decimal? @db.Decimal(15, 2)

  contractNumber          String?
  documentNumber          String?
  deliveryDocNumber       String?
  jbNumber                String?
  certCompletionRequestNo String?
  certRequestStatus       String?
  depositRefundRequestNo  String?
  contractSignatory       String?
  contractReturnStatus    String?
  remarks                 String?
  pathFolder              String?
  statusPictureUrl        String?

  updateCompanyProfile Boolean @default(false)

  projectDuration     Int?
  projectDurationUnit String?

  contractSigningDate       DateTime? @db.Timestamptz(6)
  deliveryDate              DateTime? @db.Timestamptz(6)
  paymentDate               DateTime? @db.Timestamptz(6)
  depositCollectionSchedule DateTime? @db.Timestamptz(6)

  equipment ProjectEquipment[]
  // --------------------------------

  tasks     ProjectTask[]
  members   ProjectMember[]
  dailyLogs ProjectDailyLog[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model ProjectEquipment {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String // e.g., "รถเข็น 1 แผง", "รถลาก 9 แผง"
  registrationNumber String? // For vehicle/asset tracking
  quantity           Int      @default(1)
  status             String   @default("ใช้งาน") // "ใช้งาน" (Used), "ซ่อม" (Repaired), "ชำรุด" (Damaged)
  details            String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String // "manager" | "engineer" | "admin" 
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model ProjectTask {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String? // Work category
  assigneeId  String?
  assignee    User?   @relation(fields: [assigneeId], references: [id])

  planStart   DateTime? @db.Timestamptz(6)
  planEnd     DateTime? @db.Timestamptz(6)
  actualStart DateTime? @db.Timestamptz(6)
  actualEnd   DateTime? @db.Timestamptz(6)

  planPct   Float @default(0) // % plan
  actualPct Float @default(0) // % actual
  weight    Float @default(1) // task weight

  status String @default("Pending")
  // Pending | In progress | Problematic | Completed

  priority String @default("Normal")
  order    Int    @default(0)

  parentTaskId String?
  subtasks     ProjectTask[] @relation("SubTasks")
  parentTask   ProjectTask?  @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model DailyLogWorker {
  id         String          @id @default(cuid())
  dailyLogId String
  dailyLog   ProjectDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  name     String
  position String
  hours    Float?
  status   String // 'มาทำงาน' (At Work), 'ขาด' (Absent), 'ลา' (On Leave)
  notes    String?
}

model ProjectDailyLog {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reportedBy String
  reporter   User   @relation(fields: [reportedBy], references: [id])

  date DateTime @db.Date

  // Workers Array
  workers DailyLogWorker[]

  // Weather
  weather     String?
  temperature Int?

  // Workers
  workerCount Int?
  workerNote  String?

  // Work done today
  workSummary String?
  issues      String?
  solutions   String?
  nextPlan    String?

  // Safety
  safetyNote String?
  incidents  Int     @default(0)

  // Delay Reason
  delayCause        String?
  delayResponsible  String?
  delayExpectedDate DateTime? @db.Date
  delaySeverity     String? // Minor, Moderate, Critical

  // Progress Updates & Media
  tasksPerformed Json?
  taskUpdates    Json?
  imageUrls      Json?

  // Signatures
  reporterSigUrl   String?
  supervisorSigUrl String?
  supervisorName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([projectId, date, reportedBy])
}

model BranchExpense {
  id            String   @id @default(cuid())
  branch        String   @db.VarChar(100)
  salespersonId String? // Optional, if tied to a specific salesperson
  expenseType   String   @db.VarChar(100) // e.g. "Travel", "Meals", "Marketing", "Operations"
  amount        Float    @default(0)
  date          DateTime @db.Date
  notes         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([branch])
  @@index([salespersonId])
  @@index([date])
}
