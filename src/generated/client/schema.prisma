generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  employeeId           String                @unique
  email                String?               @unique
  fullName             String
  phoneNumber          String?
  role                 String                @default("Sales Representative")
  position             String?
  password             String
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  otpCode              String?
  otpExpiresAt         DateTime?             @db.Timestamptz(6)
  isActive             Boolean               @default(true)
  assignedCompanies    Company[]             @relation("AssignedCompany")
  monthlyTargets       MonthlyTarget[]
  orders               Order[]
  quotations           Quotation[]
  schedules            Schedule[]
  telesales            Telesale[]
  telesalesKPIs        TelesalesKPI[]
  employeeSale         EmployeeSale?
  customerRequirements CustomerRequirement[]
  managedProjects      Project[]             @relation("ProjectManager")
  projectMembers       ProjectMember[]
  assignedTasks        ProjectTask[]
  reportedDailyLogs    ProjectDailyLog[]
}

model MonthlyTarget {
  id        String   @id @default(cuid())
  userId    String?
  month     Int
  year      Int
  amount    Float    @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([month, year])
}

model Schedule {
  id                 String    @id @default(cuid())
  userId             String
  title              String
  description        String?
  date               DateTime  @db.Timestamptz(6)
  status             String    @default("Planned")
  presentationStatus String?
  quotationNumber    String?
  poNumber           String?
  invoiceNumber      String?
  notes              String?
  visitReport        String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  companyId          String?
  telesaleId         String?   @unique
  company            Company?  @relation(fields: [companyId], references: [id])
  telesale           Telesale? @relation(fields: [telesaleId], references: [id])
  user               User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([date])
}

model EmployeeSale {
  id         String    @id @default(cuid())
  userId     String?   @unique
  employeeId String?   @unique
  fullName   String
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  nickname   String?
  branch     String?
  teamLeader String?
  position   String?
  department String?
  startDate  DateTime? @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id])

  @@map("employee_sales")
}

model Company {
  id                    String      @id @default(cuid())
  companyName           String
  taxId                 String?
  address               String?
  createdAt             DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(6)
  area                  String?
  branchOrHeadOffice    String?
  businessType          String?
  customerAccessChannel String?
  customerStatus        String?
  customerType          String?
  district              String?
  postalCode            String?
  province              String?
  subDistrict           String?
  assignedUserId        String?
  billingAddress        String?
  billingSubDistrict    String?
  billingDistrict       String?
  billingProvince       String?
  billingPostalCode     String?
  shippingAddress       String?
  shippingSubDistrict   String?
  shippingDistrict      String?
  shippingProvince      String?
  shippingPostalCode    String?
  paymentMethod         String?
  assignedUser          User?       @relation("AssignedCompany", fields: [assignedUserId], references: [id])
  contacts              Contact[]
  orders                Order[]
  quotations            Quotation[]
  schedules             Schedule[]
  telesales             Telesale[]

  @@index([companyName])
  @@index([assignedUserId])
}

model Contact {
  id             String      @id @default(cuid())
  companyId      String
  contactName    String
  position       String?
  mobilePhone    String?
  email          String?
  isETaxReceiver Boolean     @default(false)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  company        Company     @relation(fields: [companyId], references: [id])
  quotations     Quotation[]

  @@index([companyId])
  @@index([contactName])
}

model Quotation {
  id                   String    @id @default(cuid())
  companyId            String
  status               String    @default("Pending")
  salesBeforeVat       Float?
  transportationFee    Float?
  installationFee      Float?
  totalAmountBeforeVat Float?
  actualClosingAmount  Float?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  billingDate          DateTime? @db.Timestamptz(6)
  appointmentDate      DateTime? @db.Timestamptz(6)
  appointmentNote      String?
  contactId            String?
  followUp1            DateTime? @db.Timestamptz(6)
  followUp2            DateTime? @db.Timestamptz(6)
  followUp3            DateTime? @db.Timestamptz(6)
  followUp4            DateTime? @db.Timestamptz(6)
  invoiceNumber        String?
  poDate               DateTime? @db.Timestamptz(6)
  poNumber             String?
  productType          String?
  quotationDate        DateTime? @db.Timestamptz(6)
  quotationNumber      String?
  rejectReason         String?
  remarks              String?
  requirementDate      DateTime? @db.Timestamptz(6)
  requirementNumber    String?
  salesBranch          String?
  salesTeamLeader      String?
  salespersonId        String?
  subject              String?
  winLossReason        String?
  orders               Order[]
  company              Company   @relation(fields: [companyId], references: [id])
  contact              Contact?  @relation(fields: [contactId], references: [id])
  salesperson          User?     @relation(fields: [salespersonId], references: [id])
  jobs                 Job[]

  @@index([companyId])
  @@index([salespersonId])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

model Telesale {
  id                  String    @id @default(cuid())
  companyId           String
  userId              String?
  conversationSummary String?
  needsOrProblems     String?
  meetingObjective    String?
  competitorName      String?
  competitorPrice     Float?
  competitorPromotion String?
  lastMeetingDate     DateTime? @db.Timestamptz(6)
  result              String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  callDate            DateTime? @db.Timestamptz(6)
  callOutcome         String?
  callStatus          String?
  forwardTo           String?
  callbackAt          DateTime? @db.Timestamptz(6)
  visitDate           DateTime? @db.Timestamptz(6)
  schedule            Schedule?
  company             Company   @relation(fields: [companyId], references: [id])
  user                User?     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([lastMeetingDate])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

model BusinessType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model PostalData {
  id          String   @id @default(cuid())
  postalCode  String
  subDistrict String
  district    String
  province    String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([postalCode])
  @@index([province, district, subDistrict])
}

model Competitor {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Float?
  promotion String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([name])
}

model TelesalesKPI {
  id                String   @id @default(cuid())
  userId            String?
  month             Int
  year              Int
  weeklyCallGoal    Int      @default(300)
  monthlyCallGoal   Int      @default(1200)
  appointmentGoal   Int      @default(20)
  connectionRateMin Float    @default(0.6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  user              User?    @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        String           @unique
  companyId          String
  quotationId        String?
  salespersonId      String?
  status             String           @default("เธฃเธญเธขเธทเธเธขเธฑเธ")
  value              Float            @default(0)
  priority           String           @default("Normal")
  targetDeliveryDate DateTime?        @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  company            Company          @relation(fields: [companyId], references: [id])
  quotation          Quotation?       @relation(fields: [quotationId], references: [id])
  salesperson        User?            @relation(fields: [salespersonId], references: [id])
  statusLogs         OrderStatusLog[]

  @@index([companyId])
  @@index([quotationId])
  @@index([salespersonId])
  @@index([status])
}

model OrderStatusLog {
  id         String   @id @default(cuid())
  orderId    String
  userId     String?
  fromStatus String
  toStatus   String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Job {
  id                 String              @id @default(cuid())
  jobNumber          String              @unique
  companyCode        String
  jobType            String              @default("")
  month              Int
  yearBe             Int
  dateClosed         DateTime            @db.Timestamptz(6)
  customerName       String
  item               String?
  quotationNumber    String?
  poNumber           String?
  sellerName         String?
  quotationId        String?
  currentStep        String              @default("sales") @map("current_step")
  flowVariant        String?             @map("flow_variant")
  deliveryMethod     String?
  deliveryDate       DateTime?           @db.Timestamptz(6)
  courierCompany     String?
  trackingNumber     String?
  trackingPhotoUrl   String?
  paymentMethod      String?
  paymentStatus      String?             @default("pending")
  paymentDate        DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  salesOrderDate     DateTime?           @db.Timestamptz(6)
  creditTerms        String?
  creditDocsUrl      String?
  billingRegulations String?
  billingDocsUrl     String?
  percentageTerms    String?
  repairOrder        RepairOrder?
  stepLogs           JobStepLog[]
  paymentTasks       PaymentTask[]
  quotation          Quotation?          @relation(fields: [quotationId], references: [id])
  repairDeliveries   RepairDelivery[]
  outsourceRepairs   OutsourceRepair[]
  purchaseOrders     PurchaseOrder[]
  installationOrders InstallationOrder[]
  project            Project?

  @@map("jobs")
}

model PaymentTask {
  id                String    @id @default(cuid())
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status            String    @default("รอดำเนินการ")
  assignedTo        String?
  dueDate           DateTime? @db.Timestamptz(6)
  paidAmount        Float?
  paidDate          DateTime? @db.Timestamptz(6)
  note              String?
  installmentNo     Int?
  installmentTotal  Int?
  installmentAmount Float?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@map("payment_tasks")
}

model JobRunningNumber {
  id         String @id @default(cuid())
  yearBe     Int
  month      Int
  lastNumber Int    @default(0)

  @@unique([yearBe, month])
  @@map("job_running_numbers")
}

model JobStepLog {
  id          String   @id @default(cuid())
  jobId       String   @map("job_id")
  step        String
  completedBy String   @map("completed_by")
  department  String
  note        String?
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_step_logs")
}

model RepairOrder {
  id              String    @id @default(cuid())
  jobId           String    @unique
  invoiceNo       String?
  deliveryMethod  String?
  deliveryNoteNo  String?
  receiverName    String?
  senderName      String?
  handoverRef     String?
  phoneNumber     String?
  workType        String?
  forwardedBy     String?
  technicianName  String?
  items           Json
  symptoms        String?
  settings        String?
  checklist       Json
  receivedDate    DateTime? @db.Timestamptz(6)
  sentDate        DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  checklistImages Json?
  company         String?
  customerAddress String?
  customerCompany String?
  salesPerson     String?
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model RepairDelivery {
  id             String @id @default(cuid())
  deliveryNumber String @unique // e.g., DN69-0001

  // Link to Job
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  deliveryDate     DateTime? @db.Timestamptz(6)
  company          String?
  internalCompany  String?
  jobName          String?
  customer         String?
  customerPosition String?
  address          String?
  siteAddress      String?
  quotationNo      String?

  sender          String?
  senderPhone     String?
  technician      String?
  technicianPhone String?

  workInspect         Boolean @default(false)
  workInspectDetails  String?
  workInstall         Boolean @default(false)
  workInstallDetails  String?
  workRepair          Boolean @default(false)
  workRepairDetails   String?
  workTraining        Boolean @default(false)
  workTrainingDetails String?
  workOther           String?

  note String?

  sigSenderUrl   String?
  nameSender     String?
  sigReceiverUrl String?
  nameReceiver   String?

  status String  @default("Draft")
  pdfUrl String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model InstallationOrder {
  id             String @id @default(cuid())
  installationNo String @unique // e.g., INST-69-0001

  // Link to Job
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  installationDate DateTime? @db.Timestamptz(6)
  company          String?
  jobName          String?
  customer         String?
  customerPosition String?
  address          String?
  siteAddress      String?
  quotationNo      String?

  sender          String?
  senderPhone     String?
  technician      String?
  technicianPhone String?

  items           Json? // list of items installed
  checklist       Json? // installation steps checklist
  checklistImages Json? // any photos

  note String?

  sigSenderUrl   String?
  nameSender     String?
  sigReceiverUrl String?
  nameReceiver   String?

  // Technician Planning Fields
  plannedStartDate DateTime? @db.Timestamptz(6)
  plannedEndDate   DateTime? @db.Timestamptz(6)
  workLocation     String?
  workPlan         String?
  technicianNote   String?
  planUpdatedAt    DateTime? @db.Timestamptz(6)
  planUpdatedBy    String?

  status String  @default("Draft")
  pdfUrl String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model OutsourceRepair {
  id              String  @id @default(cuid())
  outsourceNumber String? @unique // e.g. EXT-2405-001
  jobId           String?
  job             Job?    @relation(fields: [jobId], references: [id])

  // Vendor Info
  vendorName    String? // Name of the external repair company
  vendorPhone   String? // Phone of the vendor
  vendorAddress String? // Address of the vendor

  // Customer Info
  customerName    String?
  customerPhone   String?
  customerAddress String?

  sentDate           DateTime? @db.Timestamptz(6)
  expectedReturnDate DateTime? @db.Timestamptz(6)

  items    Json // List of items sent (type, brand, serial, etc)
  symptoms String? // Description of the problem
  settings String?
  remark   String?

  sender String? // Our staff who sent it
  status String  @default("SENT") // SENT, RETURNED, CANCELLED

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model CustomerRequirement {
  id                String    @id @default(cuid())
  requirementNumber String?   @unique
  boqNumber         String?   @unique
  userId            String?
  companyName       String
  contactName       String
  salesperson       String
  date              DateTime  @db.Timestamptz(6)
  formData          Json
  isSentToService   Boolean   @default(false)
  estimationStatus  String?
  estimatedPrice    Float?
  estimationNote    String?
  estimatedBy       String?
  estimatedAt       DateTime? @db.Timestamptz(6)
  assignedTo        String?
  assignedToUserId  String?
  estimationDueDate DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  user              User?     @relation(fields: [userId], references: [id])

  @@index([companyName])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admin_login_attempts {
  id         BigInt   @id @default(autoincrement())
  username   String   @db.VarChar(50)
  ip         String   @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([ip, created_at], map: "idx_admin_attempts_ip_time")
  @@index([username, created_at], map: "idx_admin_attempts_user_time")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admins {
  id            Int        @id @default(autoincrement())
  username      String     @unique @db.VarChar(50)
  password_hash String
  full_name     String?    @db.VarChar(100)
  last_login    DateTime?  @db.Timestamptz(6)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  role          String     @default("SUPER_ADMIN") @db.VarChar(20)
  sessions      sessions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model asset_borrowings {
  id                       Int       @id @default(autoincrement())
  asset_id                 Int
  emp_id                   String    @db.VarChar(20)
  borrow_date              DateTime  @db.Timestamptz(6)
  expected_return_date     DateTime  @db.Timestamptz(6)
  actual_return_date       DateTime? @db.Timestamptz(6)
  location                 String?   @db.VarChar(255)
  condition_at_borrow      String?
  condition_at_return      String?
  is_damaged               Boolean   @default(false)
  photo_url_borrow         String?
  photo_url_return         String?
  status                   String    @default("borrowed") @db.VarChar(20)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)
  borrow_inspection_remark String?
  borrow_is_body_ok        Boolean?
  borrow_is_clean          Boolean?
  borrow_is_insurance_ok   Boolean?
  borrow_is_lights_ok      Boolean?
  borrow_is_tires_ok       Boolean?
  borrow_vehicle_status    String?   @db.VarChar(50)
  quantity                 Int       @default(1)
  assets                   assets    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  employees                employees @relation(fields: [emp_id], references: [emp_id], onDelete: Cascade)

  @@index([asset_id])
  @@index([emp_id])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assets {
  id               Int                @id @default(autoincrement())
  asset_id         String             @unique @db.VarChar(50)
  name             String             @db.VarChar(200)
  category         String?            @db.VarChar(100)
  status           String             @default("available") @db.VarChar(20)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  brand            String?            @db.VarChar(100)
  company_owner    String?            @db.VarChar(100)
  main_user        String?            @db.VarChar(200)
  usage_remark     String?
  vehicle_model    String?            @db.VarChar(200)
  vehicle_type     String?            @db.VarChar(100)
  image_url        String?
  stock            Int                @default(50)
  asset_borrowings asset_borrowings[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model birthday_claims {
  id                    String    @id @db.VarChar(30)
  emp_id                String    @db.VarChar(20)
  name                  String    @db.VarChar(100)
  amount_cash           Decimal   @db.Decimal(12, 2)
  amount_meal           Decimal   @db.Decimal(12, 2)
  receipt_url           String?
  transfer_slip_url     String?
  celebration_photo_url String?
  status                String    @default("pending") @db.VarChar(20)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  approved_by           String?   @db.VarChar(100)
  approved_at           DateTime? @db.Timestamptz(6)
  substitute_date       DateTime? @db.Date
  is_sales              Boolean   @default(false)
  employees             employees @relation(fields: [emp_id], references: [emp_id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id         String      @id @db.VarChar(10)
  name       String      @db.VarChar(100)
  center_lat Decimal     @db.Decimal(10, 8)
  center_lon Decimal     @db.Decimal(11, 8)
  radius_m   Int
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  employees  employees[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model checkins {
  id           BigInt   @id @default(autoincrement())
  timestamp    DateTime @default(now()) @db.Timestamptz(6)
  date_key     DateTime @db.Date
  time_key     DateTime @db.Time(6)
  emp_id       String   @db.VarChar(50)
  name         String   @db.VarChar(200)
  type         String   @db.VarChar(50)
  branch_name  String   @db.VarChar(200)
  lat          Decimal? @db.Decimal(10, 8)
  lon          Decimal? @db.Decimal(11, 8)
  accuracy     Int?
  distance     Int?
  capture_mode String   @default("webrtc") @db.VarChar(50)
  late_status  String?  @db.VarChar(50)
  late_min     Int?
  photo_url    String?
  project_name String?  @db.VarChar(200)
  remark       String?
  customer_id  Int?
  is_trip      Boolean? @default(false)

  @@index([branch_name], map: "idx_checkins_branch")
  @@index([date_key], map: "idx_checkins_date")
  @@index([emp_id, date_key], map: "idx_checkins_emp_date")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model commission_claims {
  id                     String    @id
  emp_id                 String    @db.VarChar(20)
